  "cards": [
    {
      "dot": "emerald",
      "title": "Data in, data out",
      "items": [
        "In: an AIXML file path plus the target .vi path",
        "Out: one JSON answer, every step's sub-answer under steps[]",
        "Rpc.GuardAsync turns any exception into {ok:false}"
      ]
    },
    {
      "dot": "cyan",
      "title": "pylabview backend",
      "items": [
        "Validate is skipped, and convert runs AixmlComposer through a resident Python worker",
        "Executability and renders go over ActiveX (LabViewCom) instead of gRPC"
      ]
    },
    {
      "dot": "amber",
      "title": "Stops early",
      "items": [
        "The first failing step ends the call and is named in failedAtStep",
        "Calls to project-local subVIs convert anyway and are then gated on execState"
      ]
    }
  ]
