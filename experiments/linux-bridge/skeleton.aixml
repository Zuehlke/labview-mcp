        <Constant _name="machine name" outputs="value:4240.value" type="string" uid="4240" uid_parent="4230" value="localhost"/>
        <Constant _name="vi server port" outputs="value:4241.value" type="uint16" uid="4241" uid_parent="4230" value="3363"/>
        <Node _name="Open Application Reference" inputs="machine name (&quot;&quot;\3A  open local reference):4240.value,port number or service name (3363):4241.value" outputs="application reference:4242.application reference,error out:4242.error out" uid="4242" uid_parent="4230"/>
        <Node _name="String To Path" inputs="string:4243.value" outputs="path:4244.path" uid="4244" uid_parent="4230"/>
        <Node _name="Open VI Reference" inputs="application reference (local):4242.application reference,vi path:4244.path,error in (no error):4242.error out" outputs="vi reference:4245.vi reference,error out:4245.error out" uid="4245" uid_parent="4230"/>
        <Node _name="Property Node" fields="read+Execution\3AState" type="{LV.VI}" inputs="reference:4245.vi reference,error in (no error):4245.error out" outputs="Execution\3AState:4246.state,reference out:4246.ref,error out:4246.error out" uid="4246" uid_parent="4230"/>
        <Constant _name="x name" outputs="value:4247.value" type="string" uid="4247" uid_parent="4230" value="x"/>
        <Node _name="Invoke Node" target="Ctrl Val.Get" type="{LV.VI}" inputs="reference:4246.ref,error in (no error):4246.error out,Control Name:4247.value" outputs="reference out:4248.ref,error out:4248.error out,Get Control Value Variant:4248.variant" uid="4248" uid_parent="4230"/>
        <Node _name="Flatten To XML" inputs="anything:4248.variant" outputs="xml string:4249.xml string" uid="4249" uid_parent="4230"/>
        <Constant _name="x 41.5 as xml" outputs="value:4270.value" type="string" uid="4270" uid_parent="4230" value="&lt;LvVariant&gt;&#10;&lt;Name&gt;Get Control Value Variant&lt;/Name&gt;&#10;&lt;DBL&gt;&#10;&lt;Name&gt;x&lt;/Name&gt;&#10;&lt;Val&gt;41.5&lt;/Val&gt;&#10;&lt;/DBL&gt;&#10;&lt;/LvVariant&gt;&#10;"/>
        <Constant _name="variant type" outputs="value:4250.value" type="variant" uid="4250" uid_parent="4230" value=""/>
        <Node _name="Unflatten From XML" inputs="xml string:4270.value,type:4250.value,error in (no error):4248.error out" outputs="value:4251.value,error out:4251.error out" uid="4251" uid_parent="4230"/>
        <Node _name="Invoke Node" target="Ctrl Val.Set" type="{LV.VI}" inputs="reference:4248.ref,error in (no error):4251.error out,Control Name:4247.value,Value:4251.value" outputs="reference out:4252.ref,error out:4252.error out" uid="4252" uid_parent="4230"/>
        <Constant _name="wait until done" outputs="value:4253.value" type="bool" uid="4253" uid_parent="4230" value="true"/>
        <Node _name="Invoke Node" target="Run VI" type="{LV.VI}" inputs="reference:4252.ref,error in (no error):4252.error out,Wait until done:4253.value" outputs="reference out:4254.ref,error out:4254.error out" uid="4254" uid_parent="4230"/>
        <Constant _name="y name" outputs="value:4255.value" type="string" uid="4255" uid_parent="4230" value="y"/>
        <Node _name="Invoke Node" target="Ctrl Val.Get" type="{LV.VI}" inputs="reference:4254.ref,error in (no error):4254.error out,Control Name:4255.value" outputs="reference out:4256.ref,error out:4256.error out,Get Control Value Variant:4256.variant" uid="4256" uid_parent="4230"/>
        <Node _name="Flatten To XML" inputs="anything:4256.variant" outputs="xml string:4257.xml string" uid="4257" uid_parent="4230"/>
        <Node _name="Close Reference" inputs="reference:4256.ref,error in (no error):4256.error out" outputs="error out:4258.error out" uid="4258" uid_parent="4230"/>
