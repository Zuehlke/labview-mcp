        <Node _name="Concatenate Strings" inputs="string:4263.value,string:4261.text,string:4264.value,string:4262.text,string:4265.value,string:4249.xml string,string:4266.value,string:4257.xml string" outputs="concatenated string:4267.reply" uid="4267" uid_parent="4230"/>
        <Tunnel _id="Out1" inputs="value:4267.reply" uid="4268" uid_parent="4230"/>
