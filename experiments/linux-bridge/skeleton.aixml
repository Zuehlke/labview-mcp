      <Tunnel _id="In3" inputs="value:4330.value" uid="4331" uid_parent="4220"/>
      <Tunnel _id="Out1" outputs="value:4223.value" uid="4223" uid_parent="4220"/>
      <Tunnel _id="Out2" outputs="value:4224.value" uid="4224" uid_parent="4220"/>

      <CaseFrame selector="&quot;probe&quot;" selectout="" uid="4230" uid_parent="4220">
