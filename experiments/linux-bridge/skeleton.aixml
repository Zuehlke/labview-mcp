<VI _name="skeleton.vi" description="Slice 1.2 bridge skeleton. Connects to 127.0.0.1 on the port named in the rendezvous file (Inputs[0], default /tmp/lvmcp-skeleton-port.txt), then loops\3A read one length-prefixed frame (4-byte big-endian length, then the payload), answer one frame. The payload probe runs the VI Server constructs the bridge needs (Open Application Reference, Open VI Reference in that instance, Property Node, Invoke Node, Ctrl Val.Get and Ctrl Val.Set through Flatten To XML and Unflatten From XML) on the VI at Inputs[1] (default /tmp/fx/Target.vi). Any other payload is echoed. The loop ends on the first TCP error (66 is the peer closing, measured). Reentrant.">
  <FreeLabel comment="Read a frame, answer a frame, until TCP ends" uid="4200" uid_parent="root"/>

  <Control _name="Inputs" conIdx="11" connection="recommended" outputs="value:4209.value" type="array{string}" uid="4209" uid_parent="root" value="[]"/>

  <Constant _name="default rendezvous path" outputs="value:4201.value" type="string" uid="4201" uid_parent="root" value="/tmp/lvmcp-skeleton-port.txt"/>
  <Constant _name="index 0" outputs="value:4320.value" type="int32" uid="4320" uid_parent="root" value="0"/>
  <Constant _name="index 1" outputs="value:4321.value" type="int32" uid="4321" uid_parent="root" value="1"/>
  <Node _name="Index Array" inputs="array:4209.value,index:4320.value" outputs="element:4322.value" uid="4322" uid_parent="root"/>
  <Node _name="Index Array" inputs="array:4209.value,index:4321.value" outputs="element:4323.value" uid="4323" uid_parent="root"/>
  <Node _name="Empty String/Path?" inputs="string/path:4322.value" outputs="empty?:4324.empty" uid="4324" uid_parent="root"/>
  <Node _name="Select" inputs="s:4324.empty,t:4201.value,f:4322.value" outputs="s? t\3Af:4325.rendezvous" uid="4325" uid_parent="root"/>
  <Constant _name="target vi path" outputs="value:4326.value" type="string" uid="4326" uid_parent="root" value="/tmp/fx/Target.vi"/>
  <Node _name="Empty String/Path?" inputs="string/path:4323.value" outputs="empty?:4327.empty" uid="4327" uid_parent="root"/>
  <Node _name="Select" inputs="s:4327.empty,t:4326.value,f:4323.value" outputs="s? t\3Af:4328.target" uid="4328" uid_parent="root"/>
  <Node _name="String To Path" inputs="string:4325.rendezvous" outputs="path:4202.path" uid="4202" uid_parent="root"/>
  <Constant _name="read whole file" outputs="value:4207.value" type="int32" uid="4207" uid_parent="root" value="-1"/>
  <Node _name="Read from Text File" inputs="file (use dialog):4202.path,count:4207.value,error in:,prompt (Open existing file):" outputs="refnum out:,text:4203.text,cancelled:,error out:4203.error out" uid="4203" uid_parent="root"/>
  <Constant _name="loopback address" outputs="value:4204.value" type="string" uid="4204" uid_parent="root" value="127.0.0.1"/>
  <Constant _name="connect timeout ms" outputs="value:4205.value" type="int32" uid="4205" uid_parent="root" value="5000"/>
  <Node _name="Decimal String To Number" inputs="string:4203.text" outputs="number:4208.number" uid="4208" uid_parent="root"/>
  <Node _name="To Unsigned Word Integer" inputs="number:4208.number" outputs="unsigned 16bit integer:4219.port" uid="4219" uid_parent="root"/>
  <Node _name="TCP Open Connection" inputs="address:4204.value,remote port or service name:4219.port,timeout ms (60000):4205.value,error in (no error):4203.error out" outputs="connection ID:4206.connection ID,error out:4206.error out" uid="4206" uid_parent="root"/>

  <Structure _name="While Loop" count="" label="One iteration per request frame" uid="4210" uid_parent="root">
    <Tunnel _id="In1" inputs="value:4206.connection ID" outputs="value:4211.value" uid="4211" uid_parent="4210"/>
    <Tunnel _id="In2" inputs="value:4206.error out" outputs="value:4218.value" uid="4218" uid_parent="4210"/>
    <Tunnel _id="In3" inputs="value:4328.target" outputs="value:4330.value" uid="4330" uid_parent="4210"/>
    <Constant _name="header bytes" outputs="value:4212.value" type="int32" uid="4212" uid_parent="4210" value="4"/>
    <Constant _name="read timeout ms" outputs="value:4213.value" type="int32" uid="4213" uid_parent="4210" value="60000"/>
    <Node _name="TCP Read" inputs="connection ID:4211.value,bytes to read:4212.value,timeout ms (25000):4213.value,error in (no error):4218.value" outputs="connection ID out:,data out:4214.data out,error out:4214.error out" uid="4214" uid_parent="4210"/>
    <Constant _name="length type" outputs="value:4215.value" type="uint32" uid="4215" uid_parent="4210" value="0"/>
    <Node _name="Unflatten From String" inputs="type:4215.value,error in (no error):4214.error out,binary string:4214.data out" outputs="value:4216.value,rest of the binary string:,error out:4216.error out" uid="4216" uid_parent="4210"/>
    <Node _name="TCP Read" inputs="connection ID:4211.value,bytes to read:4216.value,timeout ms (25000):4213.value,error in (no error):4216.error out" outputs="connection ID out:,data out:4217.data out,error out:4217.error out" uid="4217" uid_parent="4210"/>

    <Structure _name="Case Structure" selectin="4217.data out" uid="4220" uid_parent="4210">
      <Tunnel _id="In1" inputs="value:4217.data out" uid="4221" uid_parent="4220"/>
