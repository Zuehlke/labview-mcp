    </ShiftReg>
    <Node _name="Property Node" fields="write+Visible" inputs="reference:4310.ref,error in (no error):4321.err,Visible:4311.vis" outputs="reference out:,error out:4330.err" type="{LV.Control}" uid="4330" uid_parent="4300"/>
  </Structure>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="Error out." inputs="value:4322.err" type="cluster{bool.status,int32.code,string.source}" uid="4400" uid_parent="root" value="[false,0,]"/>
  <FreeLabel comment="Writes Visible on every control given" uid="0" uid_parent="root"/>
</VI>
