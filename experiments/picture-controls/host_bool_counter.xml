<VI _name="host_bool_counter.vi" description="Probe host for a customised boolean: reads the control every 50 ms for 12 s and counts the iterations it read TRUE, so a latch action shows as one count per click and a switch action as a running count. The control is replaced by the .ctl under test after generation.">
  <FreeLabel comment="Counts the reads that saw TRUE" uid="4200" uid_parent="root"/>
  <Constant _name="iterations" outputs="value:4201.value" type="int32" uid="4201" uid_parent="root" value="240"/>
  <Constant _name="zero" outputs="value:4202.value" type="int16" uid="4202" uid_parent="root" value="0"/>
  <Constant _name="period ms" outputs="value:4203.value" type="uint32" uid="4203" uid_parent="root" value="50"/>
  <Structure _name="For Loop" count="" maxin="4201.value" maxout="" uid="4210" uid_parent="root">
    <Tunnel _id="In1" inputs="value:4203.value" outputs="value:4211.value" uid="4211" uid_parent="4210"/>
    <ShiftReg uid="4212" uid_parent="4210">
      <Left inputs="value:4202.value" outputs="value:4213.value" uid="4213" uid_parent="4212"/>
      <Right inputs="value:4222.x+y" outputs="value:" uid="4214" uid_parent="4212"/>
    </ShiftReg>
    <Control _name="Boolean" outputs="value:4220.value" type="bool" uid="4220" uid_parent="4210" value="false"/>
    <Node _name="Boolean To (0\2C1)" inputs="Boolean:4220.value" outputs="0\2C 1:4221.out" uid="4221" uid_parent="4210"/>
    <Node _name="Add" inputs="x:4213.value,y:4221.out" outputs="x+y:4222.x+y" uid="4222" uid_parent="4210"/>
    <Node _name="Wait (ms)" inputs="milliseconds to wait:4211.value" outputs="millisecond timer value:" uid="4223" uid_parent="4210"/>
    <Indicator _name="count" inputs="value:4222.x+y" type="int16" uid="4224" uid_parent="4210" value="0"/>
    <Indicator _name="now" inputs="value:4220.value" type="bool" uid="4225" uid_parent="4210" value="false"/>
  </Structure>
</VI>
