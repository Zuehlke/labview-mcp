<VI _name="target.vi" description="Step 14.1 relay target (runs in the IDE, started through VI Server by relay.vi). Rendezvous stub with an override\3A the control rendezvous, when not empty, is the rendezvous file; otherwise the file is rendezvous.txt beside this VI. It waits 1500 ms first, so a target aborted by a closed reference never connects. Finds its rendezvous file beside itself (Current VI's Path, Strip Path, rendezvous.txt), reads port and token (one line\3A port, a dash, the token), connects to 127.0.0.1 on that port and sends one text message\3A hello, a dash, the token, then bar-separated evidence (Application Version Number, the first bytes of /proc/self/stat, own VI path, command line arguments, tick count). It also writes the same message to the rendezvous path plus .report. Ends after TCP Close.">
  <FreeLabel comment="Wait, find rendezvous file, report back" uid="4200" uid_parent="root"/>

  <Node _name="Property Node" fields="read+Application\3AVersion Number" type="{LV.Application}" inputs="reference:,error in (no error):" outputs="Application\3AVersion Number:4220.ver,reference out:,error out:" uid="4220" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Application\3ACommand Line Arguments" type="{LV.Application}" inputs="reference:,error in (no error):" outputs="Application\3ACommand Line Arguments:4221.args,reference out:,error out:" uid="4221" uid_parent="root"/>
  <Node _name="Current VI's Path" outputs="path:4222.path" uid="4222" uid_parent="root"/>
  <Node _name="Path To String" inputs="path:4222.path" outputs="string:4223.vipath" uid="4223" uid_parent="root"/>

  <Node _name="Strip Path" inputs="path:4222.path" outputs="stripped path:4300.dir,name:" uid="4300" uid_parent="root"/>
  <Constant _name="rendezvous file name" outputs="value:4301.value" type="string" uid="4301" uid_parent="root" value="rendezvous.txt"/>
  <Node _name="Build Path" inputs="base path:4300.dir,name or relative path:4301.value" outputs="appended path:4303.npath" uid="4303" uid_parent="root"/>
  <Control _name="rendezvous" outputs="value:4400.value" type="string" uid="4400" uid_parent="root" value=""/>
  <Node _name="Empty String/Path?" inputs="string/path:4400.value" outputs="empty?:4401.empty" uid="4401" uid_parent="root"/>
  <Node _name="String To Path" inputs="string:4400.value" outputs="path:4402.apath" uid="4402" uid_parent="root"/>
  <Node _name="Select" inputs="s:4401.empty,t:4303.npath,f:4402.apath" outputs="s? t\3Af:4403.sel" uid="4403" uid_parent="root"/>
