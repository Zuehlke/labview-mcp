  <Constant _name="dash" outputs="value:4312.value" type="string" uid="4312" uid_parent="root" value="-"/>
  <Node _name="Search/Split String" inputs="string:4311.text,search string/char (-):4312.value" outputs="substring before match:4313.port text,match + rest of string:4313.rest,offset of match:" uid="4313" uid_parent="root"/>
