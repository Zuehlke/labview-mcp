<VI _name="lvtd_discon_top.vi" description="Measurement probe\3A run Discon Typedef over every TOP-LEVEL front panel control of a file and save it in place\2C reporting per control what Is Typedef? said before and after and what each call answered.\0A\0AIt deliberately does NOT descend. The question it exists to settle is whether disconnecting the outer typedef also clears one embedded inside it - so the descent has to be absent\2C and the answer comes from extracting the saved file afterwards and counting what is left.\0A\0AThe three nodes per control are CHAINED through their error terminals on purpose. With the error inputs left unwired they carry no data dependency on each other and LabVIEW may run them in any order\2C which would make before and after meaningless. Each iteration starts a fresh chain\2C so one control's failure does not hide the next one's result. The save is sequenced by a shift register carrying the ORIGINAL error rather than the per-control ones\2C so a control that refuses to disconnect still cannot stop the file being written.">
  <Control _name="target path" conIdx="0" connection="required" description="Absolute path of the .vi or .ctl to disconnect. Saved in place." type="string" uid="4200" uid_parent="root" value="" outputs="value:4200.v"/>
  <Control _name="error in" conIdx="11" connection="recommended" type="cluster{bool.status,int32.code,string.source}" uid="4202" uid_parent="root" value="[false,0,]" outputs="value:4202.err"/>

  <Constant _name="not a typedef" outputs="value:4204.zero" type="uint32{not a typedef,typedef,strict typedef,class private data}" uid="4204" uid_parent="root" value="0"/>

  <Node _name="String To Path" inputs="string:4200.v" outputs="path:4210.path" uid="4210" uid_parent="root"/>
  <Node _name="Open VI Reference" inputs="vi path:4210.path,error in (no error):4202.err" outputs="vi reference:4212.ref,error out:4212.err" uid="4212" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Front Panel" type="{LV.VI}" inputs="reference:4212.ref,error in (no error):4212.err" outputs="Front Panel:4214.panel,reference out:,error out:4214.err" uid="4214" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Controls[]" type="{LV.Panel}" inputs="reference:4214.panel,error in (no error):4214.err" outputs="Controls[]:4216.ctrls,reference out:,error out:4216.err" uid="4216" uid_parent="root"/>

  <Structure _name="For Loop" count="" maxin="" maxout="" uid="4300" uid_parent="root">
    <Tunnel _id="In1" inputs="value:4216.ctrls" mode="index" outputs="value:4302.c" uid="4302" uid_parent="4300"/>
    <Tunnel _id="In2" inputs="value:4204.zero" outputs="value:4304.zero" uid="4304" uid_parent="4300"/>
    <ShiftReg uid="4306" uid_parent="4300">
      <Left inputs="value:4216.err" outputs="value:4308.err" uid="4310" uid_parent="4306"/>
