    </ShiftReg>

    <Node _name="Property Node" fields="read+Label,read+Is Typedef?" type="{LV.Control}" inputs="reference:4302.c,error in (no error):" outputs="Label:4320.lbl,Is Typedef?:4320.kind,reference out:,error out:4320.err" uid="4320" uid_parent="4300"/>
    <Node _name="Property Node" fields="read+Text" type="{LV.Text}" inputs="reference:4320.lbl,error in (no error):" outputs="Text:4322.name,reference out:,error out:4322.err" uid="4322" uid_parent="4300"/>
    <Node _name="Not Equal?" inputs="x:4320.kind,y:4304.zero" outputs="x != y?:4324.before" uid="4324" uid_parent="4300"/>

    <Node _name="Invoke Node" target="Discon Typedef" type="{LV.Control}" inputs="reference:4302.c,error in (no error):4320.err" outputs="reference out:,error out:4330.err,Discon Typedef:" uid="4330" uid_parent="4300"/>

    <Node _name="Property Node" fields="read+Is Typedef?" type="{LV.Control}" inputs="reference:4302.c,error in (no error):4330.err" outputs="Is Typedef?:4340.kind,reference out:,error out:4340.err" uid="4340" uid_parent="4300"/>
    <Node _name="Not Equal?" inputs="x:4340.kind,y:4304.zero" outputs="x != y?:4342.after" uid="4342" uid_parent="4300"/>

    <Node _name="Unbundle By Name" fields="code" inputs="input cluster:4330.err" outputs="code:4350.code" uid="4350" uid_parent="4300"/>
    <Node _name="Unbundle By Name" fields="code" inputs="input cluster:4340.err" outputs="code:4352.code" uid="4352" uid_parent="4300"/>

    <Tunnel _id="Out1" inputs="value:4322.name" mode="index" outputs="value:4360.names" uid="4360" uid_parent="4300"/>
    <Tunnel _id="Out2" inputs="value:4324.before" mode="index" outputs="value:4362.before" uid="4362" uid_parent="4300"/>
    <Tunnel _id="Out3" inputs="value:4342.after" mode="index" outputs="value:4364.after" uid="4364" uid_parent="4300"/>
    <Tunnel _id="Out4" inputs="value:4350.code" mode="index" outputs="value:4366.discon" uid="4366" uid_parent="4300"/>
    <Tunnel _id="Out5" inputs="value:4352.code" mode="index" outputs="value:4368.recheck" uid="4368" uid_parent="4300"/>
  </Structure>

  <Node _name="Invoke Node" target="Save.Instrument" type="{LV.VI}" inputs="reference:4212.ref,error in (no error):4312.err,Path to saved file:,Save a Copy:,Without Diagram:" outputs="reference out:4400.ref,error out:4400.err" uid="4400" uid_parent="root"/>
