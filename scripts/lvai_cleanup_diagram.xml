<VI _name="lvai_cleanup_diagram.vi" description="Runs LabVIEW's own Clean Up Diagram on one VI and saves it in place: Open VI Reference by path\2C {LV.VI} BD.CleanUp\2C Save.Instrument with the path unwired\2C Close Reference. The same two calls NI's Message Maker makes on every VI it scripts.">
  <FreeLabel comment="Clean up, then save in place" uid="4200" uid_parent="root"/>
  <Control _name="vi path" type="string" uid="4201" uid_parent="root" value="" outputs="value:4201.value"/>
  <Control _name="error in" conIdx="11" connection="recommended" type="cluster{bool.status,int32.code,string.source}" uid="4202" uid_parent="root" value="[false,0,]" outputs="value:4202.value"/>
  <Node _name="String To Path" inputs="string:4201.value" outputs="path:4220.path" uid="4220" uid_parent="root"/>
  <Node _name="Open VI Reference" inputs="vi path:4220.path,error in (no error):4202.value" outputs="vi reference:4230.vi,error out:4230.err" uid="4230" uid_parent="root"/>
  <Node _name="Invoke Node" target="BD.CleanUp" type="{LV.VI}" inputs="reference:4230.vi,error in (no error):4230.err" outputs="reference out:,error out:4240.err" uid="4240" uid_parent="root"/>
  <Node _name="Invoke Node" target="Save.Instrument" type="{LV.VI}" inputs="reference:4230.vi,error in (no error):4240.err,Path to saved file:,Save a Copy:,Without Diagram:" outputs="reference out:,error out:4250.err" uid="4250" uid_parent="root"/>
  <Node _name="Close Reference" inputs="reference:4230.vi,error in (no error):4250.err" outputs="error out:4260.err" uid="4260" uid_parent="root"/>
  <Indicator _name="error out" conIdx="15" connection="recommended" type="cluster{bool.status,int32.code,string.source}" uid="4290" uid_parent="root" value="[false,0,]" inputs="value:4260.err"/>
</VI>
