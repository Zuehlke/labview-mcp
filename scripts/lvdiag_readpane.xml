<VI _name="lvdiag_readpane.vi" description="Reads a connector pane's Pattern and its terminal count. Needed because assigning controls to the right INDICES is not enough\3A a freshly created VI gets a bigger default pattern than the target had\2C so index 11 lands on a different physical terminal. Drive it with one string input\3A the VI to inspect.">
  <Control _name="vi path" conIdx="0" connection="required" description="Full path of the VI to inspect." outputs="value:100.value" type="string" uid="100" uid_parent="root" value=""/>

  <Constant _name="sep" outputs="value:120.value" type="string" uid="120" uid_parent="root" value=" terminals\2C pattern "/>

  <Node _name="String To Path" inputs="string:100.value" outputs="path:200.path" uid="200" uid_parent="root"/>
  <Node _name="Open VI Reference" inputs="vi path:200.path" outputs="vi reference:210.viref,error out:210.err" uid="210" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Connector Pane\3AReference" type="{LV.VI}" inputs="reference:210.viref,error in (no error):210.err" outputs="Connector Pane\3AReference:220.cp,reference out:,error out:220.err" uid="220" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Number of Connection Terminals" type="{LV.ConnectorPane}" inputs="reference:220.cp,error in (no error):220.err" outputs="Number of Connection Terminals:230.n,reference out:,error out:230.err" uid="230" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Pattern" type="{LV.ConnectorPane}" inputs="reference:220.cp,error in (no error):230.err" outputs="Pattern:232.p,reference out:,error out:232.err" uid="232" uid_parent="root"/>

  <Node _name="Number To Decimal String" inputs="number:230.n" outputs="decimal integer string:240.s" uid="240" uid_parent="root"/>
  <Node _name="Number To Decimal String" inputs="number:232.p" outputs="decimal integer string:242.s" uid="242" uid_parent="root"/>
  <Node _name="Concatenate Strings" inputs="string:240.s,string:120.value,string:242.s" outputs="concatenated string:250.cat" uid="250" uid_parent="root"/>
  <Indicator _name="pane" conIdx="4" connection="recommended" description="Terminal count and pattern code." inputs="value:250.cat" type="string" uid="300" uid_parent="root" value=""/>

  <Node _name="Close Reference" inputs="reference:210.viref,error in (no error):232.err" outputs="error out:260.err" uid="260" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="source" inputs="input cluster:260.err" outputs="source:270.source" uid="270" uid_parent="root"/>
  <Indicator _name="error source" conIdx="5" connection="recommended" description="Empty when it worked." inputs="value:270.source" type="string" uid="310" uid_parent="root" value=""/>
</VI>
