  <Control _name="to palette string" description="The name of the primitive they become\2C e.g. To Long Integer." type="string" uid="4203" uid_parent="root" value="" outputs="value:4203.v"/>
  <Control _name="indices" description="Which matches to replace\2C as indices into the match list\2C pipe separated. Empty to replace none." type="string" uid="4204" uid_parent="root" value="" outputs="value:4204.v"/>
  <Control _name="save" description="TRUE saves the VI in place after the replaces. FALSE writes nothing." type="bool" uid="4205" uid_parent="root" value="false" outputs="value:4205.v"/>
  <Control _name="through active project" description="TRUE opens the VI in the active project's application instance." type="bool" uid="4206" uid_parent="root" value="false" outputs="value:4206.v"/>
