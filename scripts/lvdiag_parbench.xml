<VI _name="lvdiag_parbench_c.vi" description="Benchmark probe for iteration parallelism. One flat For Loop over the top-level diagram\2C carrying the same per-object read profile as the real exporter - Class Name\2C four To More Specific Class downcasts and the property reads behind them - but accumulating through an AUTO-INDEXING output tunnel instead of a shift register\2C because a shift register serialises the loop and blocks parallelism. Iteration parallelism itself is neither an AIXML attribute nor a scripting property\2C so it has to be switched on by hand in the IDE\3A right-click the loop\2C Configure Iteration Parallelism. Measure\2C flip\2C measure again - and remember the first run after any change measures the compiler.">
  <Control _name="vi path" conIdx="0" connection="required" description="Full path of the VI to walk." outputs="value:100.value" type="string" uid="100" uid_parent="root" value=""/>
  <Control _name="out path" conIdx="1" connection="required" description="Full path of the text file to write." outputs="value:110.value" type="string" uid="110" uid_parent="root" value=""/>

  <Constant _name="line feed" outputs="value:130.value" type="string" uid="130" uid_parent="root" value="\0A"/>
  <Constant _name="field" outputs="value:150.value" type="string" uid="150" uid_parent="root" value="/"/>
  <Constant _name="cast type" outputs="value:170.value" type="int32" uid="170" uid_parent="root" value="0"/>
  <Constant outputs="value:180.value" type="ref{LV.Structure}" uid="180" uid_parent="root" value=""/>
  <Constant outputs="value:182.value" type="ref{LV.Loop}" uid="182" uid_parent="root" value=""/>
  <Constant outputs="value:186.value" type="ref{LV.Node}" uid="186" uid_parent="root" value=""/>
  <Constant outputs="value:213.value" type="ref{LV.ControlTerminal}" uid="213" uid_parent="root" value=""/>

  <Node _name="String To Path" inputs="string:100.value" outputs="path:200.path" uid="200" uid_parent="root"/>
  <Node _name="Open VI Reference" inputs="vi path:200.path" outputs="vi reference:210.viref,error out:210.err" uid="210" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Block Diagram" type="{LV.VI}" inputs="reference:210.viref,error in (no error):210.err" outputs="Block Diagram:220.bd,reference out:,error out:220.err" uid="220" uid_parent="root"/>
  <Node _name="Property Node" fields="read+All Objects[]" type="{LV.Diagram}" inputs="reference:220.bd,error in (no error):220.err" outputs="All Objects[]:230.objs,reference out:,error out:230.err" uid="230" uid_parent="root"/>

  <Node _name="Array Size" inputs="array:230.objs" outputs="size(s):240.size" uid="240" uid_parent="root"/>
  <Node _name="Number To Decimal String" inputs="number:240.size" outputs="decimal integer string:250.str" uid="250" uid_parent="root"/>
  <Indicator _name="diagram count" conIdx="4" connection="recommended" description="Objects walked." inputs="value:250.str" type="string" uid="310" uid_parent="root" value=""/>

  <Structure _name="For Loop" count="" maxin="" maxout="" uid="400" uid_parent="root">
    <Tunnel _id="In1" inputs="value:230.objs" mode="index" outputs="value:410.value" uid="410" uid_parent="400"/>
    <Tunnel _id="In2" inputs="value:130.value" outputs="value:411.value" uid="411" uid_parent="400"/>
    <Tunnel _id="In3" inputs="value:150.value" outputs="value:413.value" uid="413" uid_parent="400"/>
    <Tunnel _id="In4" inputs="value:170.value" outputs="value:414.value" uid="414" uid_parent="400"/>
    <Tunnel _id="In5" inputs="value:180.value" outputs="value:415.value" uid="415" uid_parent="400"/>
    <Tunnel _id="In6" inputs="value:182.value" outputs="value:417.value" uid="417" uid_parent="400"/>
    <Tunnel _id="In7" inputs="value:186.value" outputs="value:423.value" uid="423" uid_parent="400"/>
    <Tunnel _id="In8" inputs="value:213.value" outputs="value:487.value" uid="487" uid_parent="400"/>

    <Node _name="Property Node" fields="read+Class Name" type="{LV.GObject}" inputs="reference:410.value" outputs="Class Name:420.cn,reference out:,error out:420.err" uid="420" uid_parent="400"/>
    <Node _name="Type Cast" inputs="x:410.value,type:414.value" outputs="*(type *) &amp;x:421.num" uid="421" uid_parent="400"/>
    <Node _name="Number To Decimal String" inputs="number:421.num" outputs="decimal integer string:422.str" uid="422" uid_parent="400"/>

    <Node _name="To More Specific Class" inputs="reference:410.value,target class:415.value" outputs="specific class reference:430.ref,error out:430.err" uid="430" uid_parent="400"/>
    <Node _name="Property Node" fields="read+Diagrams[]" type="{LV.Structure}" inputs="reference:430.ref" outputs="Diagrams[]:431.diags,reference out:,error out:431.err" uid="431" uid_parent="400"/>
    <Node _name="To More Specific Class" inputs="reference:410.value,target class:417.value" outputs="specific class reference:432.loopref,error out:432.err" uid="432" uid_parent="400"/>
    <Node _name="Property Node" fields="read+Shift Registers[]" type="{LV.Loop}" inputs="reference:432.loopref" outputs="Shift Registers[]:434.srs,reference out:,error out:434.err" uid="434" uid_parent="400"/>
    <Node _name="To More Specific Class" inputs="reference:410.value,target class:423.value" outputs="specific class reference:461.noderef,error out:461.err" uid="461" uid_parent="400"/>
    <Node _name="Property Node" fields="read+Label" type="{LV.Node}" inputs="reference:461.noderef" outputs="Label:462.lbl,reference out:,error out:462.err" uid="462" uid_parent="400"/>
    <Node _name="Property Node" fields="read+Text" type="{LV.Text}" inputs="reference:462.lbl" outputs="Text:463.txt,reference out:,error out:463.err" uid="463" uid_parent="400"/>
    <Node _name="To More Specific Class" inputs="reference:410.value,target class:487.value" outputs="specific class reference:490.ctref,error out:490.err" uid="490" uid_parent="400"/>
    <Node _name="Property Node" fields="read+Control" type="{LV.ControlTerminal}" inputs="reference:490.ctref" outputs="Control:491.ctrl,reference out:,error out:491.err" uid="491" uid_parent="400"/>
    <Node _name="Property Node" fields="read+Description" type="{LV.Control}" inputs="reference:491.ctrl" outputs="Description:492.desc,reference out:,error out:492.err" uid="492" uid_parent="400"/>

    <Node _name="Merge Errors" inputs="error in:420.err,error in:430.err,error in:431.err,error in:432.err,error in:434.err,error in:461.err,error in:462.err,error in:463.err,error in:490.err,error in:491.err,error in:492.err" outputs="error out:470.err" uid="470" uid_parent="400"/>
    <Node _name="Unbundle By Name" fields="source" inputs="input cluster:470.err" outputs="source:" uid="471" uid_parent="400"/>

    <Node _name="Concatenate Strings" inputs="string:422.str,string:413.value,string:420.cn,string:413.value,string:463.txt,string:492.desc,string:411.value" outputs="concatenated string:440.cat" uid="440" uid_parent="400"/>
    <Tunnel _id="Out1" inputs="value:440.cat" mode="index" outputs="value:450.value" uid="450" uid_parent="400"/>
  </Structure>

  <Node _name="Concatenate Strings" inputs="string:450.value" outputs="concatenated string:800.cat" uid="800" uid_parent="root"/>
  <Node _name="String To Path" inputs="string:110.value" outputs="path:810.path" uid="810" uid_parent="root"/>
  <Node _name="Write to Text File" inputs="file (use dialog):810.path,text:800.cat,error in:230.err,prompt (Choose or enter file path):" outputs="refnum out:,cancelled:,error out:820.err" uid="820" uid_parent="root"/>
  <Node _name="Close Reference" inputs="reference:210.viref,error in (no error):820.err" outputs="error out:830.err" uid="830" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="source" inputs="input cluster:830.err" outputs="source:840.source" uid="840" uid_parent="root"/>
  <Indicator _name="error source" conIdx="5" connection="recommended" description="Empty when it worked." inputs="value:840.source" type="string" uid="850" uid_parent="root" value=""/>
</VI>
