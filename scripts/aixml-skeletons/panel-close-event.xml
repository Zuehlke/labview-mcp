<?xml version="1.0" encoding="UTF-8"?>
<VI _name="panel-close-event.vi" description="Skeleton. An event loop that ends on Stop or when the user clicks the panel's close box. Panel Close? is the VI's own FILTER event: its selector names no control, and its Event Filter Node answers Discard? - TRUE keeps the panel open, so the VI can clean up and stop. Copy the shapes, not the file.">
  <Control _name="error in" conIdx="11" connection="required" description="Error from earlier code; with an error the loop ends at once." outputs="value:4200.value" type="cluster{bool.status,int32.code,string.source}" uid="4200" uid_parent="root" value="[false,0,]"/>
  <FreeLabel comment="Close box and Stop both end the loop" uid="4290" uid_parent="root"/>
  <Structure _name="While Loop" count="4220.value" uid="4220" uid_parent="root" label="Handle UI events until Stop or close">
    <ShiftReg uid="4222" uid_parent="4220">
      <Left inputs="value:4200.value" outputs="value:4223.value" uid="4223" uid_parent="4222"/>
      <Right inputs="value:4281.value" outputs="value:4224.value" uid="4224" uid_parent="4222"/>
    </ShiftReg>
    <Structure _name="Event Structure" uid="4230" uid_parent="4220">
      <Tunnel _id="In1" inputs="value:4223.value" uid="4231" uid_parent="4230"/>
      <CaseFrame selector=" &quot;Stop&quot;\3A Value Change " uid="4400" uid_parent="4230" label="Stop ends the loop">
        <Tunnel _id="In1" outputs="value:4401.value" uid="4401" uid_parent="4400"/>
        <Control _name="Stop" description="Ends the VI." outputs="value:4403.value" style="latched" type="bool" uid="4403" uid_parent="4400" value="false"/>
        <Tunnel _id="Out1" inputs="value:4403.value" uid="4404" uid_parent="4400"/>
        <Tunnel _id="Out2" inputs="value:4401.value" uid="4405" uid_parent="4400"/>
      </CaseFrame>
      <CaseFrame selector=" Panel Close? " uid="4500" uid_parent="4230" label="Keep the panel open and stop">
        <Tunnel _id="In1" outputs="value:4501.value" uid="4501" uid_parent="4500"/>
        <Constant _name="Discard" outputs="value:4502.value" type="bool" uid="4502" uid_parent="4500" value="true"/>
        <Node _name="Event Filter Node" fields="Discard?" inputs="Discard?:4502.value" uid="4503" uid_parent="4500"/>
        <Tunnel _id="Out1" inputs="value:4502.value" uid="4504" uid_parent="4500"/>
        <Tunnel _id="Out2" inputs="value:4501.value" uid="4505" uid_parent="4500"/>
      </CaseFrame>
      <Tunnel _id="Out1" outputs="value:4280.value" uid="4280" uid_parent="4230"/>
      <Tunnel _id="Out2" outputs="value:4281.value" uid="4281" uid_parent="4230"/>
    </Structure>
    <Node _name="Or" inputs="x:4280.value,y:4281.value" outputs="x .or. y?:4282.x .or. y?" uid="4282" uid_parent="4220"/>
    <Condition inputs="value:4282.x .or. y?" uid="4283" uid_parent="4220" value="stop"/>
  </Structure>
  <Indicator _name="error out" conIdx="15" connection="recommended" description="error in, or the first error of this VI." inputs="value:4224.value" type="cluster{bool.status,int32.code,string.source}" uid="4299" uid_parent="root" value="[false,0,]"/>
</VI>
