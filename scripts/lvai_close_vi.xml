<VI _name="lvai_close_vi.vi" description="Close one VI's front panel window INSIDE the IDE's application instance, which is what releases the VI from memory so ConvertAIXMLToVI can overwrite its path again (Error 1357). The bridge out of the addon's own instance is Application:Project:Active Project - Application; closing the panel while inside that instance is what does the work. Driven by RunVIAsTopLevel, which can only set STRING controls, so the path is built on the diagram.">
  <Control _name="VI Path" conIdx="1" connection="required" outputs="value:10.value" type="string" uid="10" uid_parent="root" value=""/>
  <Node _name="String To Path" inputs="string:10.value" outputs="path:12.path" uid="12" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Project\3AActive Project" type="{LV.Application}" outputs="Project\3AActive Project:20.proj,reference out:,error out:20.error out" uid="20" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Application" type="{LV.Project}" inputs="reference:20.proj,error in (no error):20.error out" outputs="Application:22.app,reference out:,error out:22.error out" uid="22" uid_parent="root"/>
  <Node _name="Open VI Reference" inputs="application reference (local):22.app,vi path:12.path,error in (no error):22.error out" outputs="vi reference:24.vi reference,error out:24.error out" uid="24" uid_parent="root"/>
  <Constant _name="Closed" type="uint32{Invalid,Standard,Closed,Hidden,Minimized,Maximized}" outputs="value:30.value" value="2" uid="30" uid_parent="root"/>
  <Node _name="Property Node" fields="write+Front Panel Window\3AState" type="{LV.VI}" inputs="reference:24.vi reference,error in (no error):24.error out,Front Panel Window\3AState:30.value" outputs="reference out:32.reference out,error out:32.error out" uid="32" uid_parent="root"/>
  <Node _name="Close Reference" inputs="reference:32.reference out,error in (no error):32.error out" outputs="error out:34.error out" uid="34" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="status,code,source" inputs="input cluster:34.error out" outputs="status:60.status,code:60.code,source:60.source" uid="60" uid_parent="root"/>
  <Indicator _name="status" conIdx="0" connection="recommended" inputs="value:60.status" type="bool" uid="50" uid_parent="root" value="false"/>
  <Indicator _name="code" conIdx="4" connection="recommended" inputs="value:60.code" type="int32" uid="51" uid_parent="root" value="0"/>
  <Indicator _name="source" conIdx="5" connection="recommended" inputs="value:60.source" type="string" uid="52" uid_parent="root" value=""/>
</VI>
