<VI _name="lvdiag_probe_v4.vi" description="Phase 0 step 4 probe. Emits the two tables a serializer needs\2C joinable by integer id\3A an OBJECT table from {LV.Diagram} All Objects[] (id\2C specific Class Name) and a NET table from {LV.Diagram} Wires[] (net id\2C then one record per terminal). Every refnum is Type Cast to int32\2C so objects\2C wires\2C terminals and owners all carry comparable ids and no per-class dispatch is needed on the diagram. Terminal record is termId/ownerId/name/dir - termId matches an object id for a ControlTerminal (which IS its own terminal)\2C ownerId matches for a node's terminal. Drive it with RunVIAsTopLevel and two string inputs\2C both full paths.">
  <Control _name="vi path" conIdx="0" connection="required" description="Full path of the VI whose block diagram is to be walked." outputs="value:100.value" type="string" uid="100" uid_parent="root" value=""/>
  <Control _name="out path" conIdx="1" connection="required" description="Full path of the text file to write." outputs="value:110.value" type="string" uid="110" uid_parent="root" value=""/>

  <Constant _name="line feed" outputs="value:130.value" type="string" uid="130" uid_parent="root" value="\0A"/>
  <Constant _name="empty" outputs="value:140.value" type="string" uid="140" uid_parent="root" value=""/>
  <Constant _name="separator" outputs="value:145.value" type="string" uid="145" uid_parent="root" value=" | "/>
  <Constant _name="field" outputs="value:150.value" type="string" uid="150" uid_parent="root" value="/"/>
  <Constant _name="is source" outputs="value:160.value" type="string" uid="160" uid_parent="root" value="SRC"/>
  <Constant _name="is sink" outputs="value:165.value" type="string" uid="165" uid_parent="root" value="snk"/>
  <Constant _name="cast type" outputs="value:170.value" type="int32" uid="170" uid_parent="root" value="0"/>
  <Constant _name="objects header" outputs="value:175.value" type="string" uid="175" uid_parent="root" value="#OBJECTS\0A"/>
  <Constant _name="nets header" outputs="value:180.value" type="string" uid="180" uid_parent="root" value="#NETS\0A"/>

  <Node _name="String To Path" inputs="string:100.value" outputs="path:200.path" uid="200" uid_parent="root"/>
  <Node _name="Open VI Reference" inputs="vi path:200.path" outputs="vi reference:210.viref,error out:210.err" uid="210" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Block Diagram" type="{LV.VI}" inputs="reference:210.viref,error in (no error):210.err" outputs="Block Diagram:220.bd,reference out:,error out:220.err" uid="220" uid_parent="root"/>
  <Node _name="Property Node" fields="read+All Objects[]" type="{LV.Diagram}" inputs="reference:220.bd,error in (no error):220.err" outputs="All Objects[]:230.objs,reference out:,error out:230.err" uid="230" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Wires[]" type="{LV.Diagram}" inputs="reference:220.bd,error in (no error):230.err" outputs="Wires[]:235.wires,reference out:,error out:235.err" uid="235" uid_parent="root"/>

  <Node _name="Array Size" inputs="array:230.objs" outputs="size(s):240.size" uid="240" uid_parent="root"/>
  <Node _name="Number To Decimal String" inputs="number:240.size" outputs="decimal integer string:250.str" uid="250" uid_parent="root"/>
  <Indicator _name="object count" conIdx="4" connection="recommended" description="Objects on the top-level block diagram." inputs="value:250.str" type="string" uid="310" uid_parent="root" value=""/>
  <Node _name="Array Size" inputs="array:235.wires" outputs="size(s):245.size" uid="245" uid_parent="root"/>
  <Node _name="Number To Decimal String" inputs="number:245.size" outputs="decimal integer string:255.str" uid="255" uid_parent="root"/>
  <Indicator _name="net count" conIdx="5" connection="recommended" description="Wires (nets) on the top-level block diagram." inputs="value:255.str" type="string" uid="320" uid_parent="root" value=""/>

  <Structure _name="For Loop" count="" maxin="" maxout="" uid="400" uid_parent="root">
    <Tunnel _id="In1" inputs="value:230.objs" mode="index" outputs="value:410.value" uid="410" uid_parent="400"/>
    <Tunnel _id="In2" inputs="value:130.value" outputs="value:415.value" uid="415" uid_parent="400"/>
    <Tunnel _id="In3" inputs="value:150.value" outputs="value:421.value" uid="421" uid_parent="400"/>
    <Tunnel _id="In4" inputs="value:170.value" outputs="value:422.value" uid="422" uid_parent="400"/>

    <Node _name="Property Node" fields="read+Class Name" type="{LV.GObject}" inputs="reference:410.value" outputs="Class Name:425.cn,reference out:,error out:" uid="425" uid_parent="400"/>
    <Node _name="Type Cast" inputs="x:410.value,type:422.value" outputs="*(type *) &amp;x:426.num" uid="426" uid_parent="400"/>
    <Node _name="Number To Decimal String" inputs="number:426.num" outputs="decimal integer string:427.str" uid="427" uid_parent="400"/>

    <Node _name="Concatenate Strings" inputs="string:430.value,string:427.str,string:421.value,string:425.cn,string:415.value" outputs="concatenated string:440.cat" uid="440" uid_parent="400"/>
    <ShiftReg uid="435" uid_parent="400">
      <Left inputs="value:140.value" outputs="value:430.value" uid="430" uid_parent="435"/>
      <Right inputs="value:440.cat" outputs="value:450.value" uid="450" uid_parent="435"/>
    </ShiftReg>
  </Structure>

  <Structure _name="For Loop" count="" maxin="" maxout="" uid="600" uid_parent="root">
    <Tunnel _id="In1" inputs="value:235.wires" mode="index" outputs="value:610.value" uid="610" uid_parent="600"/>
    <Tunnel _id="In2" inputs="value:130.value" outputs="value:615.value" uid="615" uid_parent="600"/>
    <Tunnel _id="In3" inputs="value:145.value" outputs="value:616.value" uid="616" uid_parent="600"/>
    <Tunnel _id="In4" inputs="value:140.value" outputs="value:617.value" uid="617" uid_parent="600"/>
    <Tunnel _id="In5" inputs="value:160.value" outputs="value:618.value" uid="618" uid_parent="600"/>
    <Tunnel _id="In6" inputs="value:165.value" outputs="value:619.value" uid="619" uid_parent="600"/>
    <Tunnel _id="In7" inputs="value:150.value" outputs="value:621.value" uid="621" uid_parent="600"/>
    <Tunnel _id="In8" inputs="value:170.value" outputs="value:622.value" uid="622" uid_parent="600"/>

    <Node _name="Type Cast" inputs="x:610.value,type:622.value" outputs="*(type *) &amp;x:625.num" uid="625" uid_parent="600"/>
    <Node _name="Number To Decimal String" inputs="number:625.num" outputs="decimal integer string:626.str" uid="626" uid_parent="600"/>
    <Node _name="Property Node" fields="read+Terminals[]" type="{LV.Wire}" inputs="reference:610.value" outputs="Terminals[]:630.terms,reference out:,error out:" uid="630" uid_parent="600"/>

    <Structure _name="For Loop" count="" maxin="" maxout="" uid="700" uid_parent="600">
      <Tunnel _id="In1" inputs="value:630.terms" mode="index" outputs="value:710.value" uid="710" uid_parent="700"/>
      <Tunnel _id="In2" inputs="value:616.value" outputs="value:712.value" uid="712" uid_parent="700"/>
      <Tunnel _id="In3" inputs="value:618.value" outputs="value:713.value" uid="713" uid_parent="700"/>
      <Tunnel _id="In4" inputs="value:619.value" outputs="value:714.value" uid="714" uid_parent="700"/>
      <Tunnel _id="In5" inputs="value:621.value" outputs="value:715.value" uid="715" uid_parent="700"/>
      <Tunnel _id="In6" inputs="value:622.value" outputs="value:716.value" uid="716" uid_parent="700"/>

      <Node _name="Property Node" fields="read+Name" type="{LV.Terminal}" inputs="reference:710.value" outputs="Name:720.name,reference out:,error out:" uid="720" uid_parent="700"/>
      <Node _name="Property Node" fields="read+Is Source?" type="{LV.Terminal}" inputs="reference:710.value" outputs="Is Source?:721.issrc,reference out:,error out:" uid="721" uid_parent="700"/>
      <Node _name="Property Node" fields="read+Owner (Deprecated)" type="{LV.Terminal}" inputs="reference:710.value" outputs="Owner (Deprecated):722.owner,reference out:,error out:" uid="722" uid_parent="700"/>

      <Node _name="Type Cast" inputs="x:710.value,type:716.value" outputs="*(type *) &amp;x:717.num" uid="717" uid_parent="700"/>
      <Node _name="Number To Decimal String" inputs="number:717.num" outputs="decimal integer string:718.str" uid="718" uid_parent="700"/>
      <Node _name="Type Cast" inputs="x:722.owner,type:716.value" outputs="*(type *) &amp;x:723.num" uid="723" uid_parent="700"/>
      <Node _name="Number To Decimal String" inputs="number:723.num" outputs="decimal integer string:724.str" uid="724" uid_parent="700"/>
      <Node _name="Select" inputs="t:713.value,s:721.issrc,f:714.value" outputs="s? t\3Af:725.sel" uid="725" uid_parent="700"/>

      <Node _name="Concatenate Strings" inputs="string:730.value,string:718.str,string:715.value,string:724.str,string:715.value,string:720.name,string:715.value,string:725.sel,string:712.value" outputs="concatenated string:740.cat" uid="740" uid_parent="700"/>
      <ShiftReg uid="735" uid_parent="700">
        <Left inputs="value:617.value" outputs="value:730.value" uid="730" uid_parent="735"/>
        <Right inputs="value:740.cat" outputs="value:750.value" uid="750" uid_parent="735"/>
      </ShiftReg>
    </Structure>

    <Node _name="Concatenate Strings" inputs="string:770.value,string:626.str,string:616.value,string:750.value,string:615.value" outputs="concatenated string:780.cat" uid="780" uid_parent="600"/>
    <ShiftReg uid="775" uid_parent="600">
      <Left inputs="value:140.value" outputs="value:770.value" uid="770" uid_parent="775"/>
      <Right inputs="value:780.cat" outputs="value:790.value" uid="790" uid_parent="775"/>
    </ShiftReg>
  </Structure>

  <Node _name="Concatenate Strings" inputs="string:175.value,string:450.value,string:180.value,string:790.value" outputs="concatenated string:800.cat" uid="800" uid_parent="root"/>
  <Node _name="String To Path" inputs="string:110.value" outputs="path:810.path" uid="810" uid_parent="root"/>
  <Node _name="Write to Text File" inputs="file (use dialog):810.path,text:800.cat,error in:235.err,prompt (Choose or enter file path):" outputs="refnum out:,cancelled:,error out:820.err" uid="820" uid_parent="root"/>
  <Node _name="Close Reference" inputs="reference:210.viref,error in (no error):820.err" outputs="error out:830.err" uid="830" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="source" inputs="input cluster:830.err" outputs="source:840.source" uid="840" uid_parent="root"/>
  <Indicator _name="error source" conIdx="6" connection="recommended" description="Empty when the walk succeeded." inputs="value:840.source" type="string" uid="300" uid_parent="root" value=""/>
</VI>
