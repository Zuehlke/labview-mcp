<VI _name="lvdiag_probe_v3.vi" description="Phase 0 step 3 probe. Walks by NODE and reaches the net from each terminal\3A {LV.Diagram} Functions[] -&gt; {LV.Node} Class Name plus Terminals[] -&gt; per terminal Name\2C Is Source? and Connected Wire\2C with the wire refnum Type Cast to int32 to serve as the net id. One traversal yields node identity AND net membership\2C which two separate walks could not join. One line per node\3A class then ' | ' then one 'name/dir/netid' record per terminal. Net id 0 means the terminal is unwired. Drive it with RunVIAsTopLevel and two string inputs\2C both full paths.">
  <Control _name="vi path" conIdx="0" connection="required" description="Full path of the VI whose block diagram is to be walked." outputs="value:100.value" type="string" uid="100" uid_parent="root" value=""/>
  <Control _name="out path" conIdx="1" connection="required" description="Full path of the text file to write." outputs="value:110.value" type="string" uid="110" uid_parent="root" value=""/>

  <Constant _name="line feed" outputs="value:130.value" type="string" uid="130" uid_parent="root" value="\0A"/>
  <Constant _name="empty" outputs="value:140.value" type="string" uid="140" uid_parent="root" value=""/>
  <Constant _name="separator" outputs="value:145.value" type="string" uid="145" uid_parent="root" value=" | "/>
  <Constant _name="field" outputs="value:150.value" type="string" uid="150" uid_parent="root" value="/"/>
  <Constant _name="is source" outputs="value:160.value" type="string" uid="160" uid_parent="root" value="SRC"/>
  <Constant _name="is sink" outputs="value:165.value" type="string" uid="165" uid_parent="root" value="snk"/>
  <Constant _name="cast type" outputs="value:170.value" type="int32" uid="170" uid_parent="root" value="0"/>

  <Node _name="String To Path" inputs="string:100.value" outputs="path:200.path" uid="200" uid_parent="root"/>
  <Node _name="Open VI Reference" inputs="vi path:200.path" outputs="vi reference:210.viref,error out:210.err" uid="210" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Block Diagram" type="{LV.VI}" inputs="reference:210.viref,error in (no error):210.err" outputs="Block Diagram:220.bd,reference out:,error out:220.err" uid="220" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Functions[]" type="{LV.Diagram}" inputs="reference:220.bd,error in (no error):220.err" outputs="Functions[]:230.fns,reference out:,error out:230.err" uid="230" uid_parent="root"/>

  <Node _name="Array Size" inputs="array:230.fns" outputs="size(s):240.size" uid="240" uid_parent="root"/>
  <Node _name="Number To Decimal String" inputs="number:240.size" outputs="decimal integer string:250.str" uid="250" uid_parent="root"/>
  <Indicator _name="node count" conIdx="4" connection="recommended" description="Number of functions on the top-level block diagram." inputs="value:250.str" type="string" uid="310" uid_parent="root" value=""/>

  <Structure _name="For Loop" count="" maxin="" maxout="" uid="400" uid_parent="root">
    <Tunnel _id="In1" inputs="value:230.fns" mode="index" outputs="value:410.value" uid="410" uid_parent="400"/>
    <Tunnel _id="In2" inputs="value:130.value" outputs="value:415.value" uid="415" uid_parent="400"/>
    <Tunnel _id="In3" inputs="value:145.value" outputs="value:416.value" uid="416" uid_parent="400"/>
    <Tunnel _id="In4" inputs="value:140.value" outputs="value:417.value" uid="417" uid_parent="400"/>
    <Tunnel _id="In5" inputs="value:160.value" outputs="value:418.value" uid="418" uid_parent="400"/>
    <Tunnel _id="In6" inputs="value:165.value" outputs="value:419.value" uid="419" uid_parent="400"/>
    <Tunnel _id="In7" inputs="value:150.value" outputs="value:421.value" uid="421" uid_parent="400"/>
    <Tunnel _id="In8" inputs="value:170.value" outputs="value:422.value" uid="422" uid_parent="400"/>

    <Node _name="Property Node" fields="read+Class Name" type="{LV.GObject}" inputs="reference:410.value" outputs="Class Name:425.cn,reference out:,error out:" uid="425" uid_parent="400"/>
    <Node _name="Property Node" fields="read+Terminals[]" type="{LV.Node}" inputs="reference:410.value" outputs="Terminals[]:430.terms,reference out:,error out:" uid="430" uid_parent="400"/>

    <Structure _name="For Loop" count="" maxin="" maxout="" uid="500" uid_parent="400">
      <Tunnel _id="In1" inputs="value:430.terms" mode="index" outputs="value:510.value" uid="510" uid_parent="500"/>
      <Tunnel _id="In2" inputs="value:416.value" outputs="value:512.value" uid="512" uid_parent="500"/>
      <Tunnel _id="In3" inputs="value:418.value" outputs="value:513.value" uid="513" uid_parent="500"/>
      <Tunnel _id="In4" inputs="value:419.value" outputs="value:514.value" uid="514" uid_parent="500"/>
      <Tunnel _id="In5" inputs="value:421.value" outputs="value:515.value" uid="515" uid_parent="500"/>
      <Tunnel _id="In6" inputs="value:422.value" outputs="value:516.value" uid="516" uid_parent="500"/>

      <Node _name="Property Node" fields="read+Name" type="{LV.Terminal}" inputs="reference:510.value" outputs="Name:520.name,reference out:,error out:" uid="520" uid_parent="500"/>
      <Node _name="Property Node" fields="read+Is Source?" type="{LV.Terminal}" inputs="reference:510.value" outputs="Is Source?:521.issrc,reference out:,error out:" uid="521" uid_parent="500"/>
      <Node _name="Property Node" fields="read+Connected Wire" type="{LV.Terminal}" inputs="reference:510.value" outputs="Connected Wire:522.wire,reference out:,error out:" uid="522" uid_parent="500"/>

      <Node _name="Type Cast" inputs="x:522.wire,type:516.value" outputs="*(type *) &amp;x:523.num" uid="523" uid_parent="500"/>
      <Node _name="Number To Decimal String" inputs="number:523.num" outputs="decimal integer string:524.str" uid="524" uid_parent="500"/>
      <Node _name="Select" inputs="t:513.value,s:521.issrc,f:514.value" outputs="s? t\3Af:525.sel" uid="525" uid_parent="500"/>

      <Node _name="Concatenate Strings" inputs="string:530.value,string:520.name,string:515.value,string:525.sel,string:515.value,string:524.str,string:512.value" outputs="concatenated string:540.cat" uid="540" uid_parent="500"/>
      <ShiftReg uid="535" uid_parent="500">
        <Left inputs="value:417.value" outputs="value:530.value" uid="530" uid_parent="535"/>
        <Right inputs="value:540.cat" outputs="value:550.value" uid="550" uid_parent="535"/>
      </ShiftReg>
    </Structure>

    <Node _name="Concatenate Strings" inputs="string:570.value,string:425.cn,string:416.value,string:550.value,string:415.value" outputs="concatenated string:580.cat" uid="580" uid_parent="400"/>
    <ShiftReg uid="575" uid_parent="400">
      <Left inputs="value:140.value" outputs="value:570.value" uid="570" uid_parent="575"/>
      <Right inputs="value:580.cat" outputs="value:590.value" uid="590" uid_parent="575"/>
    </ShiftReg>
  </Structure>

  <Node _name="String To Path" inputs="string:110.value" outputs="path:600.path" uid="600" uid_parent="root"/>
  <Node _name="Write to Text File" inputs="file (use dialog):600.path,text:590.value,error in:230.err,prompt (Choose or enter file path):" outputs="refnum out:,cancelled:,error out:610.err" uid="610" uid_parent="root"/>
  <Node _name="Close Reference" inputs="reference:210.viref,error in (no error):610.err" outputs="error out:620.err" uid="620" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="source" inputs="input cluster:620.err" outputs="source:630.source" uid="630" uid_parent="root"/>
  <Indicator _name="error source" conIdx="5" connection="recommended" description="Empty when the walk succeeded." inputs="value:630.source" type="string" uid="300" uid_parent="root" value=""/>
</VI>
