<VI _name="lvdiag_finalize.vi" description="Turns Allow Debugging off on a generated VI and saves it. Execution\3AAllow Debugging is a VI PROPERTY\2C so ConvertAIXMLToVI resets it every time the exporter is regenerated - the same trap as the icon. This makes the setting a repeatable step instead of a manual one. Reads the flag back after saving\2C because a return code is not evidence. Drive it with one string input\3A the full path of the VI to finalize.">
  <Control _name="vi path" conIdx="0" connection="required" description="Full path of the VI to finalize." outputs="value:100.value" type="string" uid="100" uid_parent="root" value=""/>

  <Constant _name="off" outputs="value:120.value" type="bool" uid="120" uid_parent="root" value="false"/>
  <Constant _name="yes" outputs="value:130.value" type="string" uid="130" uid_parent="root" value="debugging still ON"/>
  <Constant _name="no" outputs="value:140.value" type="string" uid="140" uid_parent="root" value="debugging off"/>

  <Node _name="String To Path" inputs="string:100.value" outputs="path:200.path" uid="200" uid_parent="root"/>
  <Node _name="Open VI Reference" inputs="vi path:200.path" outputs="vi reference:210.viref,error out:210.err" uid="210" uid_parent="root"/>
  <Node _name="Property Node" fields="write+Execution\3AAllow Debugging" type="{LV.VI}" inputs="reference:210.viref,error in (no error):210.err,Execution\3AAllow Debugging:120.value" outputs="reference out:,error out:220.err" uid="220" uid_parent="root"/>
  <Node _name="Invoke Node" target="Save\3AInstrument" type="{LV.VI}" inputs="reference:210.viref,error in (no error):220.err" outputs="reference out:,error out:230.err" uid="230" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Execution\3AAllow Debugging" type="{LV.VI}" inputs="reference:210.viref,error in (no error):230.err" outputs="Execution\3AAllow Debugging:240.dbg,reference out:,error out:240.err" uid="240" uid_parent="root"/>
  <Node _name="Select" inputs="t:130.value,s:240.dbg,f:140.value" outputs="s? t\3Af:250.sel" uid="250" uid_parent="root"/>
  <Indicator _name="state" conIdx="4" connection="recommended" description="Read back after saving - not the return code." inputs="value:250.sel" type="string" uid="300" uid_parent="root" value=""/>

  <Node _name="Close Reference" inputs="reference:210.viref,error in (no error):240.err" outputs="error out:260.err" uid="260" uid_parent="root"/>
  <Node _name="Unbundle By Name" fields="source" inputs="input cluster:260.err" outputs="source:270.source" uid="270" uid_parent="root"/>
  <Indicator _name="error source" conIdx="5" connection="recommended" description="Empty when it worked." inputs="value:270.source" type="string" uid="310" uid_parent="root" value=""/>
</VI>
