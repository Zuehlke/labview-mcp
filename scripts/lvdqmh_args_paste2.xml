  <Node _name="Property Node" fields="read+Controls[]" inputs="reference:42.Panel,error in (no error):43.error out" outputs="Controls[]:44.Controls,reference out:44.reference out,error out:44.error out" type="{LV.Panel}" uid="44" uid_parent="root"/>

  <Structure _name="For Loop" count="" maxin="" maxout="" uid="50" uid_parent="root">
