<VI _name="lvai_create_library.vi" description="Creates an EMPTY LabVIEW library (.lvlib) and saves it to library path\2C through LabVIEW's own VI Server in the ACTIVE PROJECT's application instance\3A Project\3AActive Project -&gt; Application -&gt; {LV.Application} Library.Create -&gt; {LV.Library} Save (Path) -&gt; read Path back -&gt; Close Reference. The same two methods scripts/lvai_create_actor_library.xml uses\2C which NI's AddActor provider uses. The library is NOT listed in the project here\3A the caller writes that entry with the project closed. The library reference is closed\3A a leaked provider refnum kept a new class in memory past the project close (lvclass-creation.md)\2C and the same is assumed for a library.">
  <Control _name="library path" type="path" uid="4201" uid_parent="root" value="" outputs="value:4201.value"/>
  <Control _name="error in" conIdx="11" connection="recommended" type="cluster{bool.status,int32.code,string.source}" uid="4205" uid_parent="root" value="[false,0,]" outputs="value:4205.value"/>
  <Node _name="Property Node" fields="read+Project\3AActive Project" type="{LV.Application}" inputs="error in (no error):4205.value" outputs="Project\3AActive Project:4210.proj,reference out:,error out:4210.err" uid="4210" uid_parent="root"/>
  <Node _name="Property Node" fields="read+Application" type="{LV.Project}" inputs="reference:4210.proj,error in (no error):4210.err" outputs="Application:4215.app,reference out:,error out:4215.err" uid="4215" uid_parent="root"/>
  <Node _name="Invoke Node" target="Library.Create" type="{LV.Application}" inputs="reference:4215.app,error in (no error):4215.err,Create.Default Palette:" outputs="Create Library:4220.lib,reference out:,error out:4220.err" uid="4220" uid_parent="root"/>
  <Node _name="Invoke Node" target="Save" type="{LV.Library}" inputs="reference:4220.lib,error in (no error):4220.err,Path:4201.value" outputs="reference out:4240.ref,error out:4240.err" uid="4240" uid_parent="root"/>
