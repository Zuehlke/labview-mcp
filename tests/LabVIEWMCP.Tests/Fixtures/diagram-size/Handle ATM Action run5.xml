<?xml version="1.0" encoding="UTF-8"?>
<VI _name="Handle ATM Action.vi" description="ATM state machine, one command per call. Takes the current phase (Idle, Account, Menu, Deposit, Withdraw), the verified account, the message on screen, a command (Card Inserted, Card Removed, Enter, Left 0-2, Right 0-2, Timeout) and the user input, and returns the next phase, account, message, menu name and the panel flags. Account transactions go through the ATM Accounts class on the accounts file at accounts path. A command that does not apply in the current phase changes nothing. Errors from the class or the message builder are passed to error out.">

  <FreeLabel comment="One command per call; state goes in and out." uid="lbl1" uid_parent="root"/>

  <Control _name="phase" outputs="value:c_phase.value" type="string" value="" conIdx="0" connection="recommended" description="Current phase: Idle, Account, Menu, Deposit or Withdraw." uid="c_phase" uid_parent="root"/>
  <Control _name="account" outputs="value:c_acc.value" type="string" value="" conIdx="1" connection="recommended" description="Account number verified in this session, empty before verification." uid="c_acc" uid_parent="root"/>
  <Control _name="current message" outputs="value:c_msg.value" type="string" value="" conIdx="2" connection="recommended" description="Message currently shown; returned unchanged when the command changes nothing." uid="c_msg" uid_parent="root"/>
  <Control _name="command" outputs="value:c_cmd.value" type="string" value="" conIdx="3" connection="recommended" description="Command to process: Card Inserted, Card Removed, Enter, Left 0-2, Right 0-2 or Timeout." uid="c_cmd" uid_parent="root"/>
  <Control _name="user input" outputs="value:c_ui.value" type="string" value="" conIdx="4" connection="recommended" description="Text in the User Input field: an account number or an amount." uid="c_ui" uid_parent="root"/>
  <Control _name="accounts path" outputs="value:c_path.value" type="path" value="" conIdx="5" connection="required" description="Path of the comma-separated accounts file." uid="c_path" uid_parent="root"/>
  <Control _name="error in" outputs="value:c_err.value" type="cluster{bool.status,int32.code,string.source}" value="[false,0,]" conIdx="7" connection="recommended" description="Error from a previous step; passed on to error out." uid="c_err" uid_parent="root"/>

  <Constant _name="Accounts Seed" outputs="value:seed.value" type="path" value="" uid="seed" uid_parent="root"/>
  <Call target="ATM Accounts.lvclass\3AWrite File Path 1.vi" inputs="error in (no error):c_err.value,ATM Accounts in:seed.value,File Path:c_path.value" outputs="error out:wfp.error out,ATM Accounts out:wfp.ATM Accounts out" uid="wfp" uid_parent="root"/>

  <Constant _name="Main menu name" outputs="value:k_main.value" type="string" value="Main" uid="k_main" uid_parent="root"/>
  <Call target="Get ATM Menu.vi" inputs="menu:k_main.value,error in:wfp.error out" outputs="left menu:,right menu:,left actions:gm.left actions,right actions:gm.right actions,error out:gm.error out" uid="gm" uid_parent="root"/>

  <Structure _name="Case Structure" selectin="c_phase.value" label="Command to action" uid="sa" uid_parent="root">
    <Tunnel _id="In1" inputs="value:c_cmd.value" uid="sa_i1" uid_parent="sa"/>
    <Tunnel _id="In2" inputs="value:gm.left actions" uid="sa_i2" uid_parent="sa"/>
    <Tunnel _id="In3" inputs="value:gm.right actions" uid="sa_i3" uid_parent="sa"/>
    <Tunnel _id="In4" inputs="value:c_phase.value" uid="sa_i4" uid_parent="sa"/>

    <CaseFrame selector="&quot;Idle&quot;" selectout="" uid="fa_idle" uid_parent="sa">
      <Tunnel _id="In1" outputs="value:fa_idle_cmd.value" uid="fa_idle_cmd" uid_parent="fa_idle"/>
      <Tunnel _id="In2" outputs="value:" uid="fa_idle_i2" uid_parent="fa_idle"/>
      <Tunnel _id="In3" outputs="value:" uid="fa_idle_i3" uid_parent="fa_idle"/>
      <Tunnel _id="In4" outputs="value:" uid="fa_idle_i4" uid_parent="fa_idle"/>
      <Structure _name="Case Structure" selectin="fa_idle_cmd.value" uid="si" uid_parent="fa_idle">
        <CaseFrame selector="&quot;Card Inserted&quot;" selectout="" uid="si_f1" uid_parent="si">
          <Constant outputs="value:si_k1.value" type="string" value="Start" uid="si_k1" uid_parent="si_f1"/>
          <Tunnel _id="Out1" inputs="value:si_k1.value" uid="si_f1_o1" uid_parent="si_f1"/>
        </CaseFrame>
        <CaseFrame selector="Default" selectout="" uid="si_f2" uid_parent="si">
          <Constant outputs="value:si_k2.value" type="string" value="None" uid="si_k2" uid_parent="si_f2"/>
          <Tunnel _id="Out1" inputs="value:si_k2.value" uid="si_f2_o1" uid_parent="si_f2"/>
        </CaseFrame>
        <Tunnel _id="Out1" outputs="value:si_o1.value" uid="si_o1" uid_parent="si"/>
      </Structure>
      <Tunnel _id="Out1" inputs="value:si_o1.value" uid="fa_idle_o1" uid_parent="fa_idle"/>
    </CaseFrame>

    <CaseFrame selector="&quot;Account&quot;" selectout="" uid="fa_acc" uid_parent="sa">
      <Tunnel _id="In1" outputs="value:fa_acc_cmd.value" uid="fa_acc_cmd" uid_parent="fa_acc"/>
      <Tunnel _id="In2" outputs="value:" uid="fa_acc_i2" uid_parent="fa_acc"/>
      <Tunnel _id="In3" outputs="value:" uid="fa_acc_i3" uid_parent="fa_acc"/>
      <Tunnel _id="In4" outputs="value:" uid="fa_acc_i4" uid_parent="fa_acc"/>
      <Structure _name="Case Structure" selectin="fa_acc_cmd.value" uid="sc" uid_parent="fa_acc">
        <CaseFrame selector="&quot;Enter&quot;" selectout="" uid="sc_f1" uid_parent="sc">
          <Constant outputs="value:sc_k1.value" type="string" value="Verify" uid="sc_k1" uid_parent="sc_f1"/>
          <Tunnel _id="Out1" inputs="value:sc_k1.value" uid="sc_f1_o1" uid_parent="sc_f1"/>
        </CaseFrame>
        <CaseFrame selector="&quot;Timeout&quot;,&quot;Card Removed&quot;" selectout="" uid="sc_f2" uid_parent="sc">
          <Constant outputs="value:sc_k2.value" type="string" value="Terminate" uid="sc_k2" uid_parent="sc_f2"/>
          <Tunnel _id="Out1" inputs="value:sc_k2.value" uid="sc_f2_o1" uid_parent="sc_f2"/>
        </CaseFrame>
        <CaseFrame selector="Default" selectout="" uid="sc_f3" uid_parent="sc">
          <Constant outputs="value:sc_k3.value" type="string" value="None" uid="sc_k3" uid_parent="sc_f3"/>
          <Tunnel _id="Out1" inputs="value:sc_k3.value" uid="sc_f3_o1" uid_parent="sc_f3"/>
        </CaseFrame>
        <Tunnel _id="Out1" outputs="value:sc_o1.value" uid="sc_o1" uid_parent="sc"/>
      </Structure>
      <Tunnel _id="Out1" inputs="value:sc_o1.value" uid="fa_acc_o1" uid_parent="fa_acc"/>
    </CaseFrame>

    <CaseFrame selector="&quot;Menu&quot;,&quot;Deposit&quot;,&quot;Withdraw&quot;" selectout="" uid="fa_menu" uid_parent="sa">
      <Tunnel _id="In1" outputs="value:fa_menu_cmd.value" uid="fa_menu_cmd" uid_parent="fa_menu"/>
      <Tunnel _id="In2" outputs="value:fa_menu_la.value" uid="fa_menu_la" uid_parent="fa_menu"/>
      <Tunnel _id="In3" outputs="value:fa_menu_ra.value" uid="fa_menu_ra" uid_parent="fa_menu"/>
      <Tunnel _id="In4" outputs="value:fa_menu_ph.value" uid="fa_menu_ph" uid_parent="fa_menu"/>
      <Structure _name="Case Structure" selectin="fa_menu_cmd.value" uid="sm" uid_parent="fa_menu">
        <Tunnel _id="In1" inputs="value:fa_menu_cmd.value" uid="sm_i1" uid_parent="sm"/>
        <Tunnel _id="In2" inputs="value:fa_menu_la.value" uid="sm_i2" uid_parent="sm"/>
        <Tunnel _id="In3" inputs="value:fa_menu_ra.value" uid="sm_i3" uid_parent="sm"/>
        <Tunnel _id="In4" inputs="value:fa_menu_ph.value" uid="sm_i4" uid_parent="sm"/>
        <CaseFrame selector="&quot;Left 0&quot;,&quot;Left 1&quot;,&quot;Left 2&quot;" selectout="" uid="sm_f1" uid_parent="sm">
          <Tunnel _id="In1" outputs="value:sm_f1_cmd.value" uid="sm_f1_cmd" uid_parent="sm_f1"/>
          <Tunnel _id="In2" outputs="value:sm_f1_la.value" uid="sm_f1_la" uid_parent="sm_f1"/>
          <Tunnel _id="In3" outputs="value:" uid="sm_f1_i3" uid_parent="sm_f1"/>
          <Tunnel _id="In4" outputs="value:" uid="sm_f1_i4" uid_parent="sm_f1"/>
          <Constant outputs="value:sm_f1_off.value" type="int32" value="5" uid="sm_f1_off" uid_parent="sm_f1"/>
          <Node _name="Decimal String To Number" inputs="string:sm_f1_cmd.value,offset:sm_f1_off.value" outputs="number:sm_f1_n.number" uid="sm_f1_n" uid_parent="sm_f1"/>
          <Node _name="Index Array" inputs="array:sm_f1_la.value,index:sm_f1_n.number" outputs="element:sm_f1_e.element" uid="sm_f1_e" uid_parent="sm_f1"/>
          <Tunnel _id="Out1" inputs="value:sm_f1_e.element" uid="sm_f1_o1" uid_parent="sm_f1"/>
        </CaseFrame>
        <CaseFrame selector="&quot;Right 0&quot;,&quot;Right 1&quot;,&quot;Right 2&quot;" selectout="" uid="sm_f2" uid_parent="sm">
          <Tunnel _id="In1" outputs="value:sm_f2_cmd.value" uid="sm_f2_cmd" uid_parent="sm_f2"/>
          <Tunnel _id="In2" outputs="value:" uid="sm_f2_i2" uid_parent="sm_f2"/>
          <Tunnel _id="In3" outputs="value:sm_f2_ra.value" uid="sm_f2_ra" uid_parent="sm_f2"/>
          <Tunnel _id="In4" outputs="value:" uid="sm_f2_i4" uid_parent="sm_f2"/>
          <Constant outputs="value:sm_f2_off.value" type="int32" value="6" uid="sm_f2_off" uid_parent="sm_f2"/>
          <Node _name="Decimal String To Number" inputs="string:sm_f2_cmd.value,offset:sm_f2_off.value" outputs="number:sm_f2_n.number" uid="sm_f2_n" uid_parent="sm_f2"/>
          <Node _name="Index Array" inputs="array:sm_f2_ra.value,index:sm_f2_n.number" outputs="element:sm_f2_e.element" uid="sm_f2_e" uid_parent="sm_f2"/>
          <Tunnel _id="Out1" inputs="value:sm_f2_e.element" uid="sm_f2_o1" uid_parent="sm_f2"/>
        </CaseFrame>
        <CaseFrame selector="&quot;Enter&quot;" selectout="" uid="sm_f3" uid_parent="sm">
          <Tunnel _id="In1" outputs="value:" uid="sm_f3_i1" uid_parent="sm_f3"/>
          <Tunnel _id="In2" outputs="value:" uid="sm_f3_i2" uid_parent="sm_f3"/>
          <Tunnel _id="In3" outputs="value:" uid="sm_f3_i3" uid_parent="sm_f3"/>
          <Tunnel _id="In4" outputs="value:sm_f3_ph.value" uid="sm_f3_ph" uid_parent="sm_f3"/>
          <Constant outputs="value:sm_f3_k.value" type="string" value="Do " uid="sm_f3_k" uid_parent="sm_f3"/>
          <Node _name="Concatenate Strings" inputs="string:sm_f3_k.value,string:sm_f3_ph.value" outputs="concatenated string:sm_f3_c.concatenated string" uid="sm_f3_c" uid_parent="sm_f3"/>
          <Tunnel _id="Out1" inputs="value:sm_f3_c.concatenated string" uid="sm_f3_o1" uid_parent="sm_f3"/>
        </CaseFrame>
        <CaseFrame selector="&quot;Timeout&quot;,&quot;Card Removed&quot;" selectout="" uid="sm_f4" uid_parent="sm">
          <Tunnel _id="In1" outputs="value:" uid="sm_f4_i1" uid_parent="sm_f4"/>
          <Tunnel _id="In2" outputs="value:" uid="sm_f4_i2" uid_parent="sm_f4"/>
          <Tunnel _id="In3" outputs="value:" uid="sm_f4_i3" uid_parent="sm_f4"/>
          <Tunnel _id="In4" outputs="value:" uid="sm_f4_i4" uid_parent="sm_f4"/>
          <Constant outputs="value:sm_f4_k.value" type="string" value="Terminate" uid="sm_f4_k" uid_parent="sm_f4"/>
          <Tunnel _id="Out1" inputs="value:sm_f4_k.value" uid="sm_f4_o1" uid_parent="sm_f4"/>
        </CaseFrame>
        <CaseFrame selector="Default" selectout="" uid="sm_f5" uid_parent="sm">
          <Tunnel _id="In1" outputs="value:" uid="sm_f5_i1" uid_parent="sm_f5"/>
          <Tunnel _id="In2" outputs="value:" uid="sm_f5_i2" uid_parent="sm_f5"/>
          <Tunnel _id="In3" outputs="value:" uid="sm_f5_i3" uid_parent="sm_f5"/>
          <Tunnel _id="In4" outputs="value:" uid="sm_f5_i4" uid_parent="sm_f5"/>
          <Constant outputs="value:sm_f5_k.value" type="string" value="None" uid="sm_f5_k" uid_parent="sm_f5"/>
          <Tunnel _id="Out1" inputs="value:sm_f5_k.value" uid="sm_f5_o1" uid_parent="sm_f5"/>
        </CaseFrame>
        <Tunnel _id="Out1" outputs="value:sm_o1.value" uid="sm_o1" uid_parent="sm"/>
      </Structure>
      <Tunnel _id="Out1" inputs="value:sm_o1.value" uid="fa_menu_o1" uid_parent="fa_menu"/>
    </CaseFrame>

    <CaseFrame selector="Default" selectout="" uid="fa_def" uid_parent="sa">
      <Tunnel _id="In1" outputs="value:" uid="fa_def_i1" uid_parent="fa_def"/>
      <Tunnel _id="In2" outputs="value:" uid="fa_def_i2" uid_parent="fa_def"/>
      <Tunnel _id="In3" outputs="value:" uid="fa_def_i3" uid_parent="fa_def"/>
      <Tunnel _id="In4" outputs="value:" uid="fa_def_i4" uid_parent="fa_def"/>
      <Constant outputs="value:fa_def_k.value" type="string" value="None" uid="fa_def_k" uid_parent="fa_def"/>
      <Tunnel _id="Out1" inputs="value:fa_def_k.value" uid="fa_def_o1" uid_parent="fa_def"/>
    </CaseFrame>
    <Tunnel _id="Out1" outputs="value:sa_o1.value" uid="sa_o1" uid_parent="sa"/>
  </Structure>

  <Structure _name="Case Structure" selectin="sa_o1.value" label="Perform action" uid="sb" uid_parent="root">
    <Tunnel _id="In1" inputs="value:wfp.ATM Accounts out" uid="sb_i1" uid_parent="sb"/>
    <Tunnel _id="In2" inputs="value:gm.error out" uid="sb_i2" uid_parent="sb"/>
    <Tunnel _id="In3" inputs="value:c_phase.value" uid="sb_i3" uid_parent="sb"/>
    <Tunnel _id="In4" inputs="value:c_acc.value" uid="sb_i4" uid_parent="sb"/>
    <Tunnel _id="In5" inputs="value:c_msg.value" uid="sb_i5" uid_parent="sb"/>
    <Tunnel _id="In6" inputs="value:c_ui.value" uid="sb_i6" uid_parent="sb"/>

    <CaseFrame selector="&quot;Start&quot;" selectout="" uid="b1" uid_parent="sb">
      <Tunnel _id="In1" outputs="value:" uid="b1_i1" uid_parent="b1"/>
      <Tunnel _id="In2" outputs="value:b1_err.value" uid="b1_err" uid_parent="b1"/>
      <Tunnel _id="In3" outputs="value:" uid="b1_i3" uid_parent="b1"/>
      <Tunnel _id="In4" outputs="value:b1_acc.value" uid="b1_acc" uid_parent="b1"/>
      <Tunnel _id="In5" outputs="value:" uid="b1_i5" uid_parent="b1"/>
      <Tunnel _id="In6" outputs="value:" uid="b1_i6" uid_parent="b1"/>
      <Constant outputs="value:b1_kind.value" type="uint16{Welcome,Main Menu,Verification Failed,Session Terminated,Deposit Prompt,Deposit Complete,Withdrawal Prompt,Withdrawal Complete,Withdrawal Failed,Balance}" value="0" uid="b1_kind" uid_parent="b1"/>
      <Call target="Build ATM Message.vi" inputs="message kind:b1_kind.value,error in:b1_err.value" outputs="message:b1_m.message,error out:b1_m.error out" uid="b1_m" uid_parent="b1"/>
      <Constant outputs="value:b1_ph.value" type="string" value="Account" uid="b1_ph" uid_parent="b1"/>
      <Constant outputs="value:b1_t.value" type="bool" value="true" uid="b1_t" uid_parent="b1"/>
      <Constant outputs="value:b1_f.value" type="bool" value="false" uid="b1_f" uid_parent="b1"/>
      <Tunnel _id="Out1" inputs="value:b1_ph.value" uid="b1_o1" uid_parent="b1"/>
      <Tunnel _id="Out2" inputs="value:b1_acc.value" uid="b1_o2" uid_parent="b1"/>
      <Tunnel _id="Out3" inputs="value:b1_m.message" uid="b1_o3" uid_parent="b1"/>
      <Tunnel _id="Out4" inputs="value:b1_t.value" uid="b1_o4" uid_parent="b1"/>
      <Tunnel _id="Out5" inputs="value:b1_f.value" uid="b1_o5" uid_parent="b1"/>
      <Tunnel _id="Out6" inputs="value:b1_m.error out" uid="b1_o6" uid_parent="b1"/>
    </CaseFrame>

    <CaseFrame selector="&quot;Verify&quot;" selectout="" uid="b2" uid_parent="sb">
      <Tunnel _id="In1" outputs="value:b2_cls.value" uid="b2_cls" uid_parent="b2"/>
      <Tunnel _id="In2" outputs="value:b2_err.value" uid="b2_err" uid_parent="b2"/>
      <Tunnel _id="In3" outputs="value:" uid="b2_i3" uid_parent="b2"/>
      <Tunnel _id="In4" outputs="value:b2_acc.value" uid="b2_acc" uid_parent="b2"/>
      <Tunnel _id="In5" outputs="value:" uid="b2_i5" uid_parent="b2"/>
      <Tunnel _id="In6" outputs="value:b2_ui.value" uid="b2_ui" uid_parent="b2"/>
      <Constant outputs="value:b2_tr.value" type="string" value="Verify" uid="b2_tr" uid_parent="b2"/>
      <Call target="ATM Accounts.lvclass\3AApply Transaction.vi" inputs="ATM Accounts in:b2_cls.value,transaction:b2_tr.value,account number:b2_ui.value,error in:b2_err.value" outputs="ATM Accounts out:,success:b2_ap.success,balance:,first name:b2_ap.first name,last name:b2_ap.last name,error out:b2_ap.error out" uid="b2_ap" uid_parent="b2"/>
      <Constant outputs="value:b2_pm.value" type="string" value="Menu" uid="b2_pm" uid_parent="b2"/>
      <Constant outputs="value:b2_pa.value" type="string" value="Account" uid="b2_pa" uid_parent="b2"/>
      <Node _name="Select" inputs="t:b2_pm.value,s:b2_ap.success,f:b2_pa.value" outputs="s? t\3Af:b2_s1.s? t\3Af" uid="b2_s1" uid_parent="b2"/>
      <Node _name="Select" inputs="t:b2_ui.value,s:b2_ap.success,f:b2_acc.value" outputs="s? t\3Af:b2_s2.s? t\3Af" uid="b2_s2" uid_parent="b2"/>
      <Constant outputs="value:b2_k1.value" type="uint16{Welcome,Main Menu,Verification Failed,Session Terminated,Deposit Prompt,Deposit Complete,Withdrawal Prompt,Withdrawal Complete,Withdrawal Failed,Balance}" value="1" uid="b2_k1" uid_parent="b2"/>
      <Constant outputs="value:b2_k2.value" type="uint16{Welcome,Main Menu,Verification Failed,Session Terminated,Deposit Prompt,Deposit Complete,Withdrawal Prompt,Withdrawal Complete,Withdrawal Failed,Balance}" value="2" uid="b2_k2" uid_parent="b2"/>
      <Node _name="Select" inputs="t:b2_k1.value,s:b2_ap.success,f:b2_k2.value" outputs="s? t\3Af:b2_s3.s? t\3Af" uid="b2_s3" uid_parent="b2"/>
      <Call target="Build ATM Message.vi" inputs="message kind:b2_s3.s? t\3Af,first name:b2_ap.first name,last name:b2_ap.last name,error in:b2_ap.error out" outputs="message:b2_m.message,error out:b2_m.error out" uid="b2_m" uid_parent="b2"/>
      <Node _name="Not" inputs="x:b2_ap.success" outputs=".not. x?:b2_n..not. x?" uid="b2_n" uid_parent="b2"/>
      <Constant outputs="value:b2_f.value" type="bool" value="false" uid="b2_f" uid_parent="b2"/>
      <Tunnel _id="Out1" inputs="value:b2_s1.s? t\3Af" uid="b2_o1" uid_parent="b2"/>
      <Tunnel _id="Out2" inputs="value:b2_s2.s? t\3Af" uid="b2_o2" uid_parent="b2"/>
      <Tunnel _id="Out3" inputs="value:b2_m.message" uid="b2_o3" uid_parent="b2"/>
      <Tunnel _id="Out4" inputs="value:b2_n..not. x?" uid="b2_o4" uid_parent="b2"/>
      <Tunnel _id="Out5" inputs="value:b2_f.value" uid="b2_o5" uid_parent="b2"/>
      <Tunnel _id="Out6" inputs="value:b2_m.error out" uid="b2_o6" uid_parent="b2"/>
    </CaseFrame>

    <CaseFrame selector="&quot;Balance&quot;" selectout="" uid="b3" uid_parent="sb">
      <Tunnel _id="In1" outputs="value:b3_cls.value" uid="b3_cls" uid_parent="b3"/>
      <Tunnel _id="In2" outputs="value:b3_err.value" uid="b3_err" uid_parent="b3"/>
      <Tunnel _id="In3" outputs="value:" uid="b3_i3" uid_parent="b3"/>
      <Tunnel _id="In4" outputs="value:b3_acc.value" uid="b3_acc" uid_parent="b3"/>
      <Tunnel _id="In5" outputs="value:" uid="b3_i5" uid_parent="b3"/>
      <Tunnel _id="In6" outputs="value:" uid="b3_i6" uid_parent="b3"/>
      <Constant outputs="value:b3_tr.value" type="string" value="Balance" uid="b3_tr" uid_parent="b3"/>
      <Call target="ATM Accounts.lvclass\3AApply Transaction.vi" inputs="ATM Accounts in:b3_cls.value,transaction:b3_tr.value,account number:b3_acc.value,error in:b3_err.value" outputs="ATM Accounts out:,success:,balance:b3_ap.balance,first name:,last name:,error out:b3_ap.error out" uid="b3_ap" uid_parent="b3"/>
      <Constant outputs="value:b3_kind.value" type="uint16{Welcome,Main Menu,Verification Failed,Session Terminated,Deposit Prompt,Deposit Complete,Withdrawal Prompt,Withdrawal Complete,Withdrawal Failed,Balance}" value="9" uid="b3_kind" uid_parent="b3"/>
      <Call target="Build ATM Message.vi" inputs="message kind:b3_kind.value,amount:b3_ap.balance,error in:b3_ap.error out" outputs="message:b3_m.message,error out:b3_m.error out" uid="b3_m" uid_parent="b3"/>
      <Constant outputs="value:b3_ph.value" type="string" value="Menu" uid="b3_ph" uid_parent="b3"/>
      <Constant outputs="value:b3_f.value" type="bool" value="false" uid="b3_f" uid_parent="b3"/>
      <Tunnel _id="Out1" inputs="value:b3_ph.value" uid="b3_o1" uid_parent="b3"/>
      <Tunnel _id="Out2" inputs="value:b3_acc.value" uid="b3_o2" uid_parent="b3"/>
      <Tunnel _id="Out3" inputs="value:b3_m.message" uid="b3_o3" uid_parent="b3"/>
      <Tunnel _id="Out4" inputs="value:b3_f.value" uid="b3_o4" uid_parent="b3"/>
      <Tunnel _id="Out5" inputs="value:b3_f.value" uid="b3_o5" uid_parent="b3"/>
      <Tunnel _id="Out6" inputs="value:b3_m.error out" uid="b3_o6" uid_parent="b3"/>
    </CaseFrame>

    <CaseFrame selector="&quot;Terminate&quot;" selectout="" uid="b4" uid_parent="sb">
      <Tunnel _id="In1" outputs="value:" uid="b4_i1" uid_parent="b4"/>
      <Tunnel _id="In2" outputs="value:b4_err.value" uid="b4_err" uid_parent="b4"/>
      <Tunnel _id="In3" outputs="value:" uid="b4_i3" uid_parent="b4"/>
