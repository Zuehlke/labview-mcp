# Git hooks are executed by sh.exe (Git for Windows). They MUST keep LF line
# endings even though core.autocrlf=true — otherwise the shell aborts with
# "bad interpreter: /bin/sh^M" and the hook never runs.
.githooks/pre-push  text eol=lf
*.sh                text eol=lf

# The catalogues are generated data that gets embedded in the assembly and compared byte for byte
# by build.ps1. Pinning LF keeps the embedded bytes identical on every machine instead of varying
# with core.autocrlf — the comparison passes either way, but a generated artefact should not
# change size depending on who checked it out.
*.tsv               text eol=lf
