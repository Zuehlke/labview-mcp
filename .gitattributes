# Git hooks are executed by sh.exe (Git for Windows). They MUST keep LF line
# endings even though core.autocrlf=true — otherwise the shell aborts with
# "bad interpreter: /bin/sh^M" and the hook never runs.
.githooks/pre-push  text eol=lf
*.sh                text eol=lf

# The catalogues are generated data that gets embedded in the assembly and compared byte for byte
# by build.ps1. Pinning LF keeps the embedded bytes identical on every machine instead of varying
# with core.autocrlf — the comparison passes either way, but a generated artefact should not
# change size depending on who checked it out.
*.tsv               text eol=lf

# pylabview extracts are LF by nature, and the pane tests run pylv-conpane.py over them and compare
# the result byte for byte with the fixture. Checked out as CRLF (core.autocrlf=true, which the
# Windows runner has too) the script writes LF back and the round trip can never be identical -
# green in a checkout that predates the fixture, red in a fresh clone and in the release workflow.
tests/LabVIEWMCP.Tests/Fixtures/pane/thrall/*.xml  text eol=lf

# Byte copies of LabVIEW-saved project files. Their BOM and line endings ARE the data under
# test (LvTextFileTests), so git must store and check them out unconverted -
# core.autocrlf=true would otherwise normalise them, and an assertion would test git, not us.
tests/LabVIEWMCP.Tests/Fixtures/**/*.lvproj   -text
tests/LabVIEWMCP.Tests/Fixtures/**/*.lvclass  -text
tests/LabVIEWMCP.Tests/Fixtures/**/*.lvlib    -text
